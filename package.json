{
  "name": "tabla-movimientos",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de cálculo automático de la Tabla de Movimientos por Producto (multi-sede, con panel comparativo).",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:web": "vite build --config vite.config.web.js",
    "preview:web": "vite preview --config vite.config.web.js",
    "dev:web": "vite --config vite.config.web.js",
    "dev:server": "node --env-file=.env server/index.js",
    "start:web": "node server/index.js"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  }
}
